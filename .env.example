# Copy this file to .env and fill in real values. Never commit .env.
#
# Local docker-compose dev values are provided below as sane defaults -
# change them for anything beyond your own machine.

DB_URL=jdbc:postgresql://localhost:5432/storeDB
DB_USERNAME=chaukz
DB_PASSWORD=change-me-locally

# Generate a real one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8081

# Comma-separated list of origins your frontend runs on
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Used by docker-compose.yaml for the Postgres container itself
POSTGRES_USER=chaukz
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=storeDB
