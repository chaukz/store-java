@host = http://localhost:8081

### ============================================================
### SETUP - run these 5 first, in order. Ids are captured for everything below.
### Re-run this whole block any time you restart IntelliJ or run CLEANUP.
### ============================================================

### 1. Create Category
POST {{host}}/api/admin/categories
Content-Type: application/json

{
  "name": "Shoes",
  "description": "Footwear"
}

> {%
    client.global.set("categoryId", response.body.id);
%}

### 2. Create Product
POST {{host}}/api/admin/products
Content-Type: application/json

{
  "categoryId": {{categoryId}},
  "name": "Running Sneaker",
  "description": "Lightweight daily trainer",
  "sku": "RUN-001",
  "brand": "Nova",
  "price": 899.99,
  "stockQuantity": 50
}

> {%
    client.global.set("productId", response.body.id);
%}

### 3. Create Variant (stock = 20)
POST {{host}}/api/admin/products/{{productId}}/variants
Content-Type: application/json

{
  "size": "US 9",
  "color": "Black",
  "price": 899.99,
  "stockQuantity": 20
}

> {%
    client.global.set("variantId", response.body.id);
%}

### 4. Create User (also creates their cart)
POST {{host}}/api/admin/users
Content-Type: application/json

{
  "firstName": "Thabo",
  "lastName": "Chauke",
  "email": "thabo@example.com",
  "password": "changeme123",
  "phone": "0821234567",
  "dob": "2000-05-14",
  "role": "CUSTOMER"
}

> {%
    client.global.set("userId", response.body.id);
%}

### 5. Create Address
POST {{host}}/api/users/{{userId}}/addresses
Content-Type: application/json

{
  "street": "12 Baobab Ave",
  "city": "Mbombela",
  "province": "Mpumalanga",
  "postalCode": "1200",
  "country": "South Africa"
}

> {%
    client.global.set("addressId", response.body.id);
%}


### ============================================================
### CATEGORY
### ============================================================

### List Categories
GET {{host}}/api/categories

### Get Category by id
GET {{host}}/api/categories/{{categoryId}}

### Update Category
PUT {{host}}/api/admin/categories/{{categoryId}}
Content-Type: application/json

{
  "name": "Shoes & Sneakers",
  "description": "Footwear for everyone"
}


### ============================================================
### PRODUCT
### ============================================================

### List Products
GET {{host}}/api/products

### Filter Products by category
GET {{host}}/api/products?categoryId={{categoryId}}

### Search Products by name
GET {{host}}/api/products/search?query=sneaker

### Get Product by id
GET {{host}}/api/products/{{productId}}

### Update Product
PUT {{host}}/api/admin/products/{{productId}}
Content-Type: application/json

{
  "categoryId": {{categoryId}},
  "name": "Running Sneaker Pro",
  "description": "Updated lightweight daily trainer",
  "sku": "RUN-001",
  "brand": "Nova",
  "price": 949.99,
  "stockQuantity": 40
}


### ============================================================
### PRODUCT VARIANT
### ============================================================

### List Variants for a Product
GET {{host}}/api/products/{{productId}}/variants

### Update Variant
PUT {{host}}/api/admin/variants/{{variantId}}
Content-Type: application/json

{
  "size": "US 9",
  "color": "Midnight Black",
  "price": 849.99,
  "stockQuantity": 20
}


### ============================================================
### USER
### ============================================================

### List Users
GET {{host}}/api/users

### Get User by id  (check: response must NOT contain a password field)
GET {{host}}/api/users/{{userId}}

### Update User
PUT {{host}}/api/users/{{userId}}
Content-Type: application/json

{
  "firstName": "Thabo",
  "lastName": "Chauke",
  "email": "thabo@example.com",
  "password": "changeme123",
  "phone": "0821234567",
  "dob": "2000-05-14",
  "role": "CUSTOMER"
}


### ============================================================
### ADDRESS
### ============================================================

### List Addresses for a User
GET {{host}}/api/users/{{userId}}/addresses

### Update Address
PUT {{host}}/api/addresses/{{addressId}}
Content-Type: application/json

{
  "street": "14 Baobab Ave",
  "city": "Mbombela",
  "province": "Mpumalanga",
  "postalCode": "1200",
  "country": "South Africa"
}


### ============================================================
### CART - run in order, this sequence proves the business rules
### ============================================================

### Empty cart (should exist already, created at registration)
GET {{host}}/api/users/{{userId}}/cart

### Add 2 to cart
POST {{host}}/api/users/{{userId}}/cart/items
Content-Type: application/json

{
  "productVariantId": {{variantId}},
  "quantity": 2
}

> {%
    client.global.set("cartItemId", response.body.items[0].id);
%}

### Add 3 MORE of the same variant
### PROOF: quantity must become 5 in ONE item, not two separate rows
POST {{host}}/api/users/{{userId}}/cart/items
Content-Type: application/json

{
  "productVariantId": {{variantId}},
  "quantity": 3
}

### View cart - expect itemCount 5, one item, total = 5 x unitPrice
GET {{host}}/api/users/{{userId}}/cart

### Update item quantity - ABSOLUTE set, not additive (5 -> 4)
PUT {{host}}/api/users/{{userId}}/cart/items/{{cartItemId}}
Content-Type: application/json

{
  "quantity": 4
}

### Remove the item
DELETE {{host}}/api/users/{{userId}}/cart/items/{{cartItemId}}

### Clear cart (empties it, keeps the cart row)
DELETE {{host}}/api/users/{{userId}}/cart


### ============================================================
### CHECKOUT - run this whole block in order.
### The three stock checks are the real test.
### ============================================================

### C1. Stock BEFORE checkout - note the number
GET {{host}}/api/products/{{productId}}/variants

### C2. Add 3 to cart
POST {{host}}/api/users/{{userId}}/cart/items
Content-Type: application/json

{
  "productVariantId": {{variantId}},
  "quantity": 3
}

### C3. Checkout - expect 201, status PENDING, paymentStatus PENDING
POST {{host}}/api/users/{{userId}}/checkout
Content-Type: application/json

{
  "addressId": {{addressId}},
  "paymentMethod": "CARD"
}

> {%
    client.global.set("orderId", response.body.id);
%}

### C4. Cart must now be EMPTY (items [], total 0)
GET {{host}}/api/users/{{userId}}/cart

### C5. Stock must be DOWN by 3 vs C1
GET {{host}}/api/products/{{productId}}/variants

### C6. Order history for this user
GET {{host}}/api/users/{{userId}}/orders

### C7. Get the order by id
GET {{host}}/api/orders/{{orderId}}

### C8. Admin - all orders
GET {{host}}/api/admin/orders

### C9. Cancel the order
POST {{host}}/api/orders/{{orderId}}/cancel

### C10. Stock must be BACK UP by 3 vs C5
GET {{host}}/api/products/{{productId}}/variants

### C11. Cancel again - expect 400, already cancelled
POST {{host}}/api/orders/{{orderId}}/cancel


### ============================================================
### ERROR CASES
### ============================================================

### 404 - category that doesn't exist
GET {{host}}/api/categories/999999

### 404 - product that doesn't exist
GET {{host}}/api/products/999999

### 404 - user that doesn't exist
GET {{host}}/api/users/999999

### 404 - order that doesn't exist
GET {{host}}/api/orders/999999

### 404 - bad category id on product create
POST {{host}}/api/admin/products
Content-Type: application/json

{
  "categoryId": 999999,
  "name": "Ghost Product",
  "price": 10.00,
  "stockQuantity": 5
}

### 404 - bad product id on variant create
POST {{host}}/api/admin/products/999999/variants
Content-Type: application/json

{
  "size": "US 9",
  "color": "Black",
  "price": 899.99,
  "stockQuantity": 20
}

### 404 - bad user id on address create
POST {{host}}/api/users/999999/addresses
Content-Type: application/json

{
  "street": "Ghost St",
  "city": "Nowhere",
  "province": "N/A",
  "postalCode": "0000",
  "country": "N/A"
}

### 404 - bad variant id on add to cart
POST {{host}}/api/users/{{userId}}/cart/items
Content-Type: application/json

{
  "productVariantId": 999999,
  "quantity": 1
}

### 400 - checkout with an empty cart
POST {{host}}/api/users/{{userId}}/checkout
Content-Type: application/json

{
  "addressId": {{addressId}},
  "paymentMethod": "CARD"
}

### 400 - insufficient stock
POST {{host}}/api/users/{{userId}}/cart/items
Content-Type: application/json

{
  "productVariantId": {{variantId}},
  "quantity": 9999
}

### 400 - validation, missing category name
POST {{host}}/api/admin/categories
Content-Type: application/json

{
  "description": "no name here"
}

### 400 - validation, missing product name
POST {{host}}/api/admin/products
Content-Type: application/json

{
  "categoryId": {{categoryId}},
  "price": 10.00,
  "stockQuantity": 5
}

### 400 - validation, missing user first name
POST {{host}}/api/admin/users
Content-Type: application/json

{
  "lastName": "Chauke",
  "email": "thabo@example.com",
  "password": "changeme123"
}

### 400 - validation, zero quantity on add to cart
POST {{host}}/api/users/{{userId}}/cart/items
Content-Type: application/json

{
  "productVariantId": {{variantId}},
  "quantity": 0
}

### 400 - invalid payment method
POST {{host}}/api/users/{{userId}}/checkout
Content-Type: application/json

{
  "addressId": {{addressId}},
  "paymentMethod": "BITCOIN"
}


### ============================================================
### CLEANUP - DESTRUCTIVE. Everything above stops working after this.
### Only run when you want a clean database. Re-run SETUP afterwards.
### ============================================================

### Delete Address
DELETE {{host}}/api/addresses/{{addressId}}

### Delete User
DELETE {{host}}/api/admin/users/{{userId}}

### Delete Variant
DELETE {{host}}/api/admin/variants/{{variantId}}

### Delete Product
DELETE {{host}}/api/admin/products/{{productId}}

### Delete Category
DELETE {{host}}/api/admin/categories/{{categoryId}}

### Correct login - expect 200, real token
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "thabo@example.com", "password": "changeme123" }

### Wrong password - expect 401
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "thabo@example.com", "password": "wrongpassword" }