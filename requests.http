@host = http://localhost:8081

### ============================================================
### SETUP - run top to bottom. Two identities get created:
### an ADMIN token (from the seeded account) and a CUSTOMER token
### (a fresh user you create). Everything below depends on these.
### ============================================================

### 1. Login as the seeded admin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@store.com",
  "password": "admin123"
}

> {%
    client.global.set("adminToken", response.body.token);
%}

### 2. Create Category (admin)
POST {{host}}/api/admin/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Shoes",
  "description": "Footwear"
}

> {%
    client.global.set("categoryId", response.body.id);
%}

### 3. Create Product (admin)
POST {{host}}/api/admin/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "categoryId": {{categoryId}},
  "name": "Running Sneaker",
  "description": "Lightweight daily trainer",
  "sku": "RUN-001",
  "brand": "Nova",
  "price": 899.99,
  "stockQuantity": 50
}

> {%
    client.global.set("productId", response.body.id);
%}

### 4. Create Variant (admin) - stock = 20
POST {{host}}/api/admin/products/{{productId}}/variants
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "size": "US 9",
  "color": "Black",
  "price": 899.99,
  "stockQuantity": 20
}

> {%
    client.global.set("variantId", response.body.id);
%}

### 5. Create a customer account (admin creates it)
POST {{host}}/api/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Thabo",
  "lastName": "Chauke",
  "email": "thabo@example.com",
  "password": "changeme123",
  "phone": "0821234567",
  "dob": "2000-05-14",
  "role": "CUSTOMER"
}

### 6. Login as that customer
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "thabo@example.com",
  "password": "changeme123"
}

> {%
    client.global.set("customerToken", response.body.token);
%}

### 7. Customer creates their own address (no userId in the URL - it's their token)
POST {{host}}/api/addresses
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "street": "12 Baobab Ave",
  "city": "Mbombela",
  "province": "Mpumalanga",
  "postalCode": "1200",
  "country": "South Africa"
}

> {%
    client.global.set("addressId", response.body.id);
%}

### 8. A second customer - used later to prove ownership is enforced
POST {{host}}/api/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Nomsa",
  "lastName": "Dlamini",
  "email": "nomsa@example.com",
  "password": "differentpass1",
  "phone": "0839876543",
  "dob": "1998-03-02",
  "role": "CUSTOMER"
}

### 9. Login as the second customer
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "nomsa@example.com",
  "password": "differentpass1"
}

> {%
    client.global.set("otherCustomerToken", response.body.token);
%}


### ============================================================
### CATEGORY / PRODUCT / VARIANT - public reads, admin writes
### ============================================================

### List Categories - public, no token needed
GET {{host}}/api/categories

### List Products - public
GET {{host}}/api/products

### Filter Products by category - public
GET {{host}}/api/products?categoryId={{categoryId}}

### List Variants - public
GET {{host}}/api/products/{{productId}}/variants

### Update Category - admin only
PUT {{host}}/api/admin/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Shoes & Sneakers",
  "description": "Footwear for everyone"
}

### Update Category with NO token - expect 401
PUT {{host}}/api/admin/categories/{{categoryId}}
Content-Type: application/json

{
  "name": "Should fail",
  "description": "No auth header sent"
}

### Update Category with a CUSTOMER token - expect 403, not 401
PUT {{host}}/api/admin/categories/{{categoryId}}
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "name": "Should also fail",
  "description": "Valid login, wrong role"
}


### ============================================================
### CART - customer-owned, no userId in the URL
### ============================================================

### Empty cart (created automatically at registration)
GET {{host}}/api/cart
Authorization: Bearer {{customerToken}}

### Add 2 to cart
POST {{host}}/api/cart/items
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productVariantId": {{variantId}},
  "quantity": 2
}

> {%
    client.global.set("cartItemId", response.body.items[0].id);
%}

### Add 3 MORE of the same variant - proof: becomes 5 in ONE item
POST {{host}}/api/cart/items
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productVariantId": {{variantId}},
  "quantity": 3
}

### View cart - expect itemCount 5, one item
GET {{host}}/api/cart
Authorization: Bearer {{customerToken}}

### Cart with NO token - expect 401
GET {{host}}/api/cart

### Update item quantity - absolute set (5 -> 3, leaving stock for checkout)
PUT {{host}}/api/cart/items/{{cartItemId}}
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "quantity": 3
}


### ============================================================
### CHECKOUT / ORDERS - customer-owned, no userId in the URL
### ============================================================

### Stock BEFORE checkout - note the number
GET {{host}}/api/products/{{productId}}/variants

### Checkout
POST {{host}}/api/checkout
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "addressId": {{addressId}},
  "paymentMethod": "CARD"
}

> {%
    client.global.set("orderId", response.body.id);
%}

### Cart must now be EMPTY
GET {{host}}/api/cart
Authorization: Bearer {{customerToken}}

### Stock must be DOWN by 3
GET {{host}}/api/products/{{productId}}/variants

### My order history
GET {{host}}/api/orders
Authorization: Bearer {{customerToken}}

### Get the order by id - as its owner
GET {{host}}/api/orders/{{orderId}}
Authorization: Bearer {{customerToken}}

### PROOF: the SECOND customer tries the same order id - expect 404, not the order
GET {{host}}/api/orders/{{orderId}}
Authorization: Bearer {{otherCustomerToken}}

### PROOF: the second customer tries to cancel it - expect 404
POST {{host}}/api/orders/{{orderId}}/cancel
Authorization: Bearer {{otherCustomerToken}}

### Admin CAN see it via the admin endpoint, regardless of ownership
GET {{host}}/api/admin/orders
Authorization: Bearer {{adminToken}}

### Owner cancels their own order - expect 200
POST {{host}}/api/orders/{{orderId}}/cancel
Authorization: Bearer {{customerToken}}

### Stock must be BACK UP by 3
GET {{host}}/api/products/{{productId}}/variants

### Cancel again - expect 400, already cancelled
POST {{host}}/api/orders/{{orderId}}/cancel
Authorization: Bearer {{customerToken}}


### ============================================================
### ADDRESSES - customer-owned, ownership now enforced
### ============================================================

### My addresses
GET {{host}}/api/addresses
Authorization: Bearer {{customerToken}}

### Update my own address - expect 200
PUT {{host}}/api/addresses/{{addressId}}
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "street": "14 Baobab Ave",
  "city": "Mbombela",
  "province": "Mpumalanga",
  "postalCode": "1200",
  "country": "South Africa"
}

### PROOF: second customer tries to update the FIRST customer's address - expect 404
PUT {{host}}/api/addresses/{{addressId}}
Authorization: Bearer {{otherCustomerToken}}
Content-Type: application/json

{
  "street": "Hacked St",
  "city": "Nowhere",
  "province": "N/A",
  "postalCode": "0000",
  "country": "N/A"
}


### ============================================================
### PAYMENTS - admin only
### ============================================================

### Get payment for an order
GET {{host}}/api/orders/{{orderId}}/payment
Authorization: Bearer {{customerToken}}

### List all payments - admin only
GET {{host}}/api/admin/payments
Authorization: Bearer {{adminToken}}


### ============================================================
### ERROR CASES - validation and not-found, still work as before
### ============================================================

### 404 - category that doesn't exist
GET {{host}}/api/categories/999999

### 404 - product that doesn't exist
GET {{host}}/api/products/999999

### 400 - validation, missing category name
POST {{host}}/api/admin/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "description": "no name here"
}

### 409 - duplicate email
POST {{host}}/api/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Thabo",
  "lastName": "Chauke",
  "email": "thabo@example.com",
  "password": "irrelevant",
  "phone": "0000000000",
  "dob": "2000-01-01",
  "role": "CUSTOMER"
}


### ============================================================
### CLEANUP - DESTRUCTIVE. Run last, only when starting fresh.
### After this, re-run SETUP from the top.
### ============================================================

### Delete Variant
DELETE {{host}}/api/admin/variants/{{variantId}}
Authorization: Bearer {{adminToken}}

### Delete Product
DELETE {{host}}/api/admin/products/{{productId}}
Authorization: Bearer {{adminToken}}

### Delete Category
DELETE {{host}}/api/admin/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}